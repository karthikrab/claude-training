{
  "permissions": {
    "allow": [
      "Bash(npm start)",
      "Bash(npm test)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "internal": {
        "source": {
          "source": "github",
          "repo": "sameergijare/claude-training",
          "ref": "feature/responsetrain15",
          "path": "plugins-day8/.claude-plugin/marketplace.json"
      }
    }
  },
  "enabledPlugins": {
    "pr-check@internal": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "./build"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.com"
      ]
    }
  },
  "plansDirectory": "./plans"
}